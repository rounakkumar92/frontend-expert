datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl-openssl-3.0.x"]
}

enum Role {
  ADMIN
  AUTHOR
  READER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         Role      @default(AUTHOR)
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
  bookmarks    Bookmark[]
  articleViews ArticleView[]
  searchEvents SearchEvent[]

  @@map("users")
}

model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  excerpt     String
  content     String
  publishedAt DateTime?
  status      ArticleStatus @default(DRAFT)
  readTime    String
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  tags      Tag[]
  revisions Int   @default(1)

  @@map("articles")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@map("categories")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@map("tags")
}

model Bookmark {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleSlug String
  createdAt   DateTime @default(now())

  @@unique([userId, articleSlug])
  @@map("bookmarks")
}

model ArticleView {
  id              String   @id @default(uuid())
  articleSlug     String
  articleTitle    String?
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId       String
  source          String?
  fromSlug        String?
  device          String?
  readingProgress Int?
  createdAt       DateTime @default(now())

  @@index([articleSlug, createdAt])
  @@index([sessionId, articleSlug, createdAt])
  @@index([createdAt])
  @@index([fromSlug, articleSlug])
  @@map("article_views")
}

model SearchEvent {
  id          String   @id @default(uuid())
  query       String
  resultCount Int
  clickedSlug String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([resultCount, createdAt])
  @@index([createdAt])
  @@map("search_events")
}

model DiscoveryEvent {
  id        String   @id @default(uuid())
  type      String
  target    String
  fromSlug  String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([type, target])
  @@index([createdAt])
  @@map("discovery_events")
}

